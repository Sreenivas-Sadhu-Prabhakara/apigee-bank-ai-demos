            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"Facility availability\", () => pm.expect(j.data.facilities[0].available_minor).to.eql(20000000));"
            ]
          }
        }
      ]
    },
    {
      "name": "Baseline forecast",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{treasury_maker_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{treasury_maker_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "baseline-1"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/treasury/forecasts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_date\": \"2026-09-14\",\n  \"end_date\": \"2026-09-18\",\n  \"delays\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"No shortfall\", () => pm.expect(j.data.funding_required_minor).to.eql(0));",
              "pm.test(\"Friday cash\", () => pm.expect(j.data.daily[4].closing_minor).to.eql(10000000));"
            ]
          }
        }
      ]
    },
    {
      "name": "All three receivables delayed",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{treasury_maker_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{treasury_maker_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "delayed-1"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/treasury/forecasts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_date\": \"2026-09-14\",\n  \"end_date\": \"2026-09-18\",\n  \"delays\": [\n    {\n      \"receivable_id\": \"rec-001\",\n      \"days\": 10\n    },\n    {\n      \"receivable_id\": \"rec-002\",\n      \"days\": 10\n    },\n    {\n      \"receivable_id\": \"rec-003\",\n      \"days\": 10\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.collectionVariables.set(\"forecast_id\", j.data.id);",
              "pm.test(\"INR 70000 shortfall\", () => pm.expect(j.data.funding_required_minor).to.eql(7000000));",
              "pm.test(\"Exact daily balances\", () => pm.expect(j.data.daily.map(x => x.closing_minor)).to.eql([12000000,12000000,8000000,8000000,-7000000]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Prepare funding proposal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{treasury_maker_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{treasury_maker_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "funding-1"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/treasury/funding-proposals",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"forecast_id\": \"{{forecast_id}}\",\n  \"facility_id\": \"facility-001\",\n  \"amount_minor\": 7000000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.collectionVariables.set(\"funding_id\", j.data.id);",
              "pm.test(\"Pending approval\", () => pm.expect(j.data.status).to.eql(\"PENDING_APPROVAL\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Maker cannot self-approve via human client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{treasury_maker_human_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{treasury_maker_human_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "self-approval-1"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/treasury/funding-proposals/{{funding_id}}/approvals",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"APPROVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([403]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"Expected error code\", () => pm.expect(j.error.code).to.eql(\"SELF_APPROVAL_FORBIDDEN\"));"
            ]
          }
        }
      ]
    },
