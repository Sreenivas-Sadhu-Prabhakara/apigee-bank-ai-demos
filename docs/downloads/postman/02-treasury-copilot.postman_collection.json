{
  "info": {
    "name": "02 Treasury — calculations and approvals",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Exact cash-flow results and two-person human approval tests; no LLM required.\nRun in order against the implemented contracts. Banking data is synthetic. Credentials are issued by the presenter-only harness. Do not share a used collection without clearing credential variables."
  },
  "item": [
    {
      "name": "00 Create isolated synthetic session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-Admin-Key",
            "value": "{{demo_admin_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{harness_url}}/demo/v1/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scenario\": \"treasury\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.expect(j.session_id).to.be.a(\"string\");",
              "pm.collectionVariables.set(\"session_id\", j.session_id);",
              "for (const [name, c] of Object.entries(j.credentials)) {",
              "  pm.collectionVariables.set(name + \"_token\", c.access_token);",
              "  pm.collectionVariables.set(name + \"_key\", c.api_key);",
              "}",
              "pm.collectionVariables.set(\"quota_denied\", \"false\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Read position",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{treasury_maker_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{treasury_maker_key}}"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/treasury/position"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"Opening cash\", () => pm.expect(j.data.available_cash_minor).to.eql(12000000));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read receivables",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{treasury_maker_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{treasury_maker_key}}"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/treasury/receivables"
