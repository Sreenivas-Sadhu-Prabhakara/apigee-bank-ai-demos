            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"Receivables count\", () => pm.expect(j.data.receivables.length).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read payables",
