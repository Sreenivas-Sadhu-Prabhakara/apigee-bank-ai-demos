    {
      "name": "Screen allowed note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{investigator_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{investigator_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway_url}}/ai/v1/screen",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"item_id\": \"note-001\",\n  \"text\": \"Customer reports replacing their phone yesterday.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"Allowed note\", () => pm.expect(j.data.action).to.eql(\"ALLOW\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Save evidence-linked brief",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{investigator_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{investigator_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "brief-1"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/investigations/cases/case-001/briefs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"New device and beneficiary require verification\",\n  \"findings\": [\n    {\n      \"text\": \"A new device was observed before the payment.\",\n      \"evidence_ids\": [\n        \"signal-001\",\n        \"ftxn-002\"\n      ]\n    },\n    {\n      \"text\": \"The customer reportedly replaced their phone.\",\n      \"evidence_ids\": [\n        \"note-001\"\n      ]\n    }\n  ],\n  \"unknowns\": [\n    \"Payment purpose and customer authorization are unverified.\"\n  ],\n  \"recommended_next_steps\": [\n    \"Contact the customer through an established bank channel.\"\n  ],\n  \"excluded_evidence_ids\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.collectionVariables.set(\"brief_id\", j.data.id);",
              "pm.test(\"Draft only\", () => pm.expect(j.data.status).to.eql(\"DRAFT\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read brief",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{investigator_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{investigator_key}}"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/investigations/cases/case-001/briefs/{{brief_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"Two findings\", () => pm.expect(j.data.findings.length).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "Presenter fault: malicious_note = true",
      "request": {
        "method": "POST",
        "header": [
