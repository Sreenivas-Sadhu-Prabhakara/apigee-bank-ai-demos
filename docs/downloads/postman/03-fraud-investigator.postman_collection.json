{
  "info": {
    "name": "03 Fraud investigation — evidence and screening",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tests mock investigation APIs and independent export denial. Set screening_mode=mock for deterministic fixture screening or model-armor for actual screening results.\nRun in order against the implemented contracts. Banking data is synthetic. Credentials are issued by the presenter-only harness. Do not share a used collection without clearing credential variables."
  },
  "item": [
    {
      "name": "00 Create isolated synthetic session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-Admin-Key",
            "value": "{{demo_admin_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{harness_url}}/demo/v1/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scenario\": \"fraud\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.expect(j.session_id).to.be.a(\"string\");",
              "pm.collectionVariables.set(\"session_id\", j.session_id);",
              "for (const [name, c] of Object.entries(j.credentials)) {",
              "  pm.collectionVariables.set(name + \"_token\", c.access_token);",
              "  pm.collectionVariables.set(name + \"_key\", c.api_key);",
              "}",
              "pm.collectionVariables.set(\"quota_denied\", \"false\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Read case",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{investigator_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{investigator_key}}"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/investigations/cases/case-001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};"
            ]
          }
        }
      ]
    },
