          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([403]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"Expected error code\", () => pm.expect(j.error.code).to.eql(\"TOOL_NOT_ALLOWED\"));"
            ]
          }
        }
      ]
    },
