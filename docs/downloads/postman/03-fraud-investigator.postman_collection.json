            "key": "X-Demo-Admin-Key",
            "value": "{{demo_admin_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{harness_url}}/demo/v1/sessions/{{session_id}}/faults",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fault\": \"malicious_note\",\n  \"enabled\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
