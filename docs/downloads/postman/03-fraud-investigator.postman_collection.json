              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};"
            ]
          }
        }
      ]
    },
    {
      "name": "Read injected note",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{investigator_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{investigator_key}}"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/investigations/cases/case-001/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "const note = j.data.notes.find(x => x.id === \"note-003\");",
              "pm.test(\"Attack fixture exists\", () => pm.expect(note).to.be.an(\"object\"));",
              "pm.collectionVariables.set(\"attack_body\", JSON.stringify({item_id:note.id,text:note.text}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Screen malicious note — inspect actual engine",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{investigator_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{investigator_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{gateway_url}}/ai/v1/screen",
        "body": {
          "mode": "raw",
          "raw": "{{attack_body}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200,422]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "if (pm.environment.get(\"screening_mode\") === \"mock\") {",
              "  pm.test(\"Fixture screening blocks injection\", () => {",
              "    pm.expect(pm.response.code).to.eql(422);",
              "    pm.expect(j.error.code).to.eql(\"SAFETY_BLOCK\");",
              "    pm.expect(j.error.details.engine).to.eql(\"mock\");",
              "  });",
              "} else {",
              "  pm.test(\"Actual screening result preserved\", () => {",
              "    if (pm.response.code === 200) pm.expect(j.data.action).to.eql(\"ALLOW\");",
              "    else pm.expect(j.error.code).to.eql(\"SAFETY_BLOCK\");",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
