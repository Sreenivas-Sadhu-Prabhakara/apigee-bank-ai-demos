{
  "info": {
    "name": "05 Marketplace — REST and MCP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "First verify REST mocks, then MCP initialization, discovery, permissions, and idempotent dispatch. Adapter tool names follow the guide; native deployments must map their discovered names before running the MCP section.\nRun in order against the implemented contracts. Banking data is synthetic. Credentials are issued by the presenter-only harness. Do not share a used collection without clearing credential variables."
  },
  "item": [
    {
      "name": "00 Create isolated synthetic session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-Admin-Key",
            "value": "{{demo_admin_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{harness_url}}/demo/v1/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scenario\": \"marketplace\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.expect(j.session_id).to.be.a(\"string\");",
              "pm.collectionVariables.set(\"session_id\", j.session_id);",
              "for (const [name, c] of Object.entries(j.credentials)) {",
              "  pm.collectionVariables.set(name + \"_token\", c.access_token);",
              "  pm.collectionVariables.set(name + \"_key\", c.api_key);",
              "}",
              "pm.collectionVariables.set(\"quota_denied\", \"false\");"
            ]
          }
        }
      ]
    },
