    {
      "name": "Initialize MCP partner_reconcile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{partner_reconcile_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{partner_reconcile_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json, text/event-stream"
          }
        ],
        "url": "{{gateway_url}}/tools/partners/mcp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"{{mcp_protocol_version}}\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"bank-demo-postman\",\n      \"version\": \"1.0.0\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "\nconst raw = pm.response.text().trim();\nlet j = {};\nif (raw.startsWith(\"data:\") || raw.startsWith(\"event:\") || raw.startsWith(\":\")) {\n  const messages = raw.split(/\\r?\\n\\r?\\n/).map(block =>\n    block.split(/\\r?\\n/).filter(line => line.startsWith(\"data:\")).map(line => line.slice(5).trimStart()).join(\"\\n\")\n  ).filter(Boolean).filter(text => text !== \"[DONE]\").map(text => JSON.parse(text));\n  j = messages.find(x => x.id !== undefined && (x.result !== undefined || x.error !== undefined)) || {};\n} else if (raw) j = JSON.parse(raw);\n",
              "pm.expect(j.result.protocolVersion).to.be.a(\"string\");",
              "pm.collectionVariables.set(\"partner_reconcile_protocol\", j.result.protocolVersion);",
              "const session = pm.response.headers.get(\"Mcp-Session-Id\");",
              "if (session) pm.collectionVariables.set(\"partner_reconcile_mcp_session\", session);",
              "else pm.collectionVariables.unset(\"partner_reconcile_mcp_session\");"
            ]
          }
        }
      ]
    },
