      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:\"MCP-Protocol-Version\",value:pm.collectionVariables.get(\"partner_reconcile_protocol\") || pm.environment.get(\"mcp_protocol_version\")});",
              "const session = pm.collectionVariables.get(\"partner_reconcile_mcp_session\");",
              "if (session) pm.request.headers.upsert({key:\"Mcp-Session-Id\",value:session});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([202]).to.include(pm.response.code));",
              "\nconst raw = pm.response.text().trim();\nlet j = {};\nif (raw.startsWith(\"data:\") || raw.startsWith(\"event:\") || raw.startsWith(\":\")) {\n  const messages = raw.split(/\\r?\\n\\r?\\n/).map(block =>\n    block.split(/\\r?\\n/).filter(line => line.startsWith(\"data:\")).map(line => line.slice(5).trimStart()).join(\"\\n\")\n  ).filter(Boolean).filter(text => text !== \"[DONE]\").map(text => JSON.parse(text));\n  j = messages.find(x => x.id !== undefined && (x.result !== undefined || x.error !== undefined)) || {};\n} else if (raw) j = JSON.parse(raw);\n"
            ]
          }
        }
      ]
    },
