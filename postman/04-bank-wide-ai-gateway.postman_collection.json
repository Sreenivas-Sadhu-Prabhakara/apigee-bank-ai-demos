{
  "info": {
    "name": "04 AI gateway — routing, fallback, usage",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Default model_mode=mock provides deterministic quota checks. With model_mode=ollama, token counts vary; calibrate quota/window and observe an actual 429 separately. Fault flags select logical routes; they must not stop Ollama.\nRun in order against the implemented contracts. Banking data is synthetic. Credentials are issued by the presenter-only harness. Do not share a used collection without clearing credential variables."
  },
  "item": [
    {
      "name": "00 Create isolated synthetic session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-Admin-Key",
            "value": "{{demo_admin_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{harness_url}}/demo/v1/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scenario\": \"gateway\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.expect(j.session_id).to.be.a(\"string\");",
              "pm.collectionVariables.set(\"session_id\", j.session_id);",
              "for (const [name, c] of Object.entries(j.credentials)) {",
              "  pm.collectionVariables.set(name + \"_token\", c.access_token);",
              "  pm.collectionVariables.set(name + \"_key\", c.api_key);",
              "}",
              "pm.collectionVariables.set(\"quota_denied\", \"false\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Support first answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{support_app_token}}"
          },
          {
