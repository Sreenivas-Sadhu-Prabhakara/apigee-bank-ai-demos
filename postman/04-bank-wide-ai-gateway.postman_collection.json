        "body": {
          "mode": "raw",
          "raw": "{\n  \"use_case\": \"public_faq\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"How do I report a lost card?\"\n    }\n  ],\n  \"tools\": [],\n  \"max_output_tokens\": 200,\n  \"stream\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([200]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.test(\"No fallback\", () => pm.expect(j.gateway.fallback_used).to.eql(false));"
            ]
          }
        }
      ]
    },
