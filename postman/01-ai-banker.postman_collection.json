    {
      "name": "Prepare dispute draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{retail_full_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{retail_full_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
