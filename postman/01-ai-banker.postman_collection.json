              "pm.test(\"Expected error code\", () => pm.expect(j.error.code).to.eql(\"RESOURCE_NOT_FOUND\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Propose freeze",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{retail_full_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{retail_full_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "freeze-proposal-1"
          }
        ],
        "url": "{{gateway_url}}/bank/v1/action-proposals",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"FREEZE_CARD\",\n  \"resource_id\": \"card-001\",\n  \"payload\": {\n    \"reason\": \"LOST\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect([201]).to.include(pm.response.code));",
              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.collectionVariables.set(\"freeze_action\", j.data.action_id);"
            ]
          }
        }
      ]
    },
