              "const j = pm.response.text().trim() ? pm.response.json() : {};",
              "pm.collectionVariables.set(\"dispute_id\", j.data.id);",
              "pm.test(\"Fixture-derived amount\", () => pm.expect(j.data.amount_minor).to.eql(2499900));",
              "pm.test(\"Draft only\", () => pm.expect(j.data.status).to.eql(\"DRAFT\"));"
            ]
          }
        }
