        "url": "{{gateway_url}}/bank/v1/disputes/drafts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action_id\": \"{{dispute_action}}\",\n  \"confirmation_id\": \"{{dispute_confirmation}}\"\n}",
          "options": {
            "raw": {
